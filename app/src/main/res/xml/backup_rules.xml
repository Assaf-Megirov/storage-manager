<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices on API 30 and below.
   SyncPreferencesStore holds this install's device id and its main-device flag. Restoring those
   onto a second device would give two devices one identity, and both would believe they are main.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="SyncPreferencesStore.xml"/>
</full-backup-content>
