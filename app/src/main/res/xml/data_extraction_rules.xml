<?xml version="1.0" encoding="utf-8"?><!--
   Backup and transfer rules for API 31 and above. See backup_rules.xml for why the sync
   preferences are excluded: the device id and main-device flag must not be copied to another
   device, or two devices end up sharing one sync identity.
-->
<data-extraction-rules>
    <cloud-backup>
    <exclude domain="sharedpref" path="SyncPreferencesStore.xml"/>
    </cloud-backup>
    <device-transfer>
    <exclude domain="sharedpref" path="SyncPreferencesStore.xml"/>
    </device-transfer>
</data-extraction-rules>
